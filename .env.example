# ============================================================================
# Martes Hub — Variables de entorno
# ============================================================================

# --- Base de datos (Neon Postgres) ------------------------------------------
# Usa el connection string POOLED (Transaction Pooler, puerto 6543) con
# pgbouncer=true y connection_limit=1 como recomienda Payload + Neon.
# NO usar el URL directo sin pooler: agota conexiones en serverless.
DATABASE_URL=postgresql://user:pass@ep-xxxxx.us-east-2.aws.neon.tech:6543/neondb?sslmode=require&pgbouncer=true&connection_limit=1

# --- Payload ----------------------------------------------------------------
# Obligatorio en producción (Vercel lanza error si falta). Mínimo 32 caracteres.
PAYLOAD_SECRET=change-me-min-32-characters-secret

# --- OpenBSP (mensajería omnicanal) -----------------------------------------
# Claves de la instancia HOSTED de OpenBSP (PostgREST/Supabase).
OPENBSP_API_KEY=
OPENBSP_PUBLISHABLE_KEY=
OPENBSP_ORG_ID=
OPENBSP_PHONE_NUMBER_ID=
# Token compartido con OpenBSP para firmar los webhooks entrantes (Bearer).
# OBLIGATORIO: el endpoint /api/webhooks/openbsp responde 503 si falta.
OPENBSP_WEBHOOK_TOKEN=
# URL del proyecto Supabase que aloja OpenBSP (opcional, tiene default).
OPENBSP_SUPABASE_URL=

# --- Tally (formularios) ----------------------------------------------------
# Secreto compartido para validar firmas HMAC de Tally. OBLIGATORIO:
# /api/webhooks/tally responde 503 si falta (la validación no es opcional).
TALLY_SIGNING_SECRET=

# --- Resend (email) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Secreto Svix para validar webhooks de estado de email. OBLIGATORIO si se
# desea rastrear delivered/bounced/complained.
RESEND_WEBHOOK_SECRET=

# --- S3-compatible (media & documentos) --------------------------------------
# Opcional: si S3_BUCKET está presente se activa el storage de archivos
# (Cloudflare R2 o AWS S3). Sin S3, media se guarda localmente.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# --- Workspace --------------------------------------------------------------
# Tenant por defecto para admins sin tenant asignado explícitamente.
# Se resuelve por env, NUNCA hardcodeado en código.
WORKSPACE_DEFAULT_TENANT=martes

# --- Redes sociales (Meta Graph API) ----------------------------------------
# Integración real de publicación y métricas. Mientras sea false/'',
# los jobs fetch-social-metrics y publish-scheduled-posts NO escriben datos
# inventados y dejan los posts en "programado".
META_GRAPH_API_ENABLED=false

# --- Campañas de email programadas -----------------------------------------
# Activa el envío automático de campañas con scheduledAt en el pasado.
# Requiere RESEND_API_KEY configurado. Por defecto false: las campañas con
# scheduledAt se acumulan y se envían manualmente desde el botón "Enviar".
EMAIL_CAMPAIGNS_AUTO_SEND=false

# --- Cron trigger (job queue) ------------------------------------------------
# El endpoint GET /api/cron dispara el job queue de Payload.
# Requiere este secreto en el header: Authorization: Bearer <CRON_SECRET>.
#
# Opciones para disparar el cron (Vercel Free no incluye crons nativos):
#
#  1. GitHub Actions — .github/workflows/trigger-jobs.yml (ya configurado).
#     Añadir en GitHub → Settings → Secrets → Actions:
#       APP_URL     = https://tu-app.vercel.app
#       CRON_SECRET = <mismo valor que aquí>
#     ⚠ GitHub deshabilita el workflow tras 60 días sin actividad en el repo.
#        Usar workflow_dispatch manual o Upstash QStash si el repo es poco activo.
#
#  2. Upstash QStash (https://upstash.com/qstash) — más confiable, free tier:
#     - 500 msg/día gratis. */5 * * * * = 288 ejecuciones/día.
#     - Crear Schedule → URL: https://tu-app.vercel.app/api/cron
#       Header: Authorization: Bearer <CRON_SECRET>
#       Cron: */5 * * * *
#
# En local dejar vacío — el handler corre sin validar el secreto.
CRON_SECRET=

# --- Webhook rate limiting (opcional, defaults sensatos) ---------------------
# WEBHOOK_RATE_LIMIT_MAX=120
# WEBHOOK_RATE_LIMIT_WINDOW_MS=60000