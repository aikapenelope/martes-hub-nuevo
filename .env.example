# ============================================================================
# Martes Hub — Variables de entorno
# ============================================================================

# --- Base de datos (Neon Postgres) ------------------------------------------
# Usa el connection string POOLED (Transaction Pooler, puerto 6543) con
# pgbouncer=true y connection_limit=1 como recomienda Payload + Neon.
# NO usar el URL directo sin pooler para esta variable: agota conexiones en serverless.
DATABASE_URL=postgresql://user:pass@ep-xxxxx.us-east-2.aws.neon.tech:6543/neondb?sslmode=require&pgbouncer=true&connection_limit=1

# Connection string DIRECTO (sin -pooler en el host, sin pgbouncer=true).
# OBLIGATORIO para que las migraciones sean confiables: el pooler de Neon
# corre en modo transaction pooling, que Neon mismo desrecomienda para
# migraciones (rompe estado de sesión: SET/PREPARE/locks de advisory). Sin
# esta variable, `pnpm migrate` (scripts/migrate.mjs) cae de vuelta a
# DATABASE_URL (pooled) — funciona la mayoría de las veces, pero no es lo
# que Neon recomienda. https://neon.com/docs/connect/choose-connection
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Payload ----------------------------------------------------------------
# Obligatorio en producción (Vercel lanza error si falta). Mínimo 32 caracteres.
PAYLOAD_SECRET=change-me-min-32-characters-secret

# --- OpenBSP (mensajería omnicanal) -----------------------------------------
# Claves de la instancia HOSTED de OpenBSP (PostgREST/Supabase).
OPENBSP_API_KEY=
OPENBSP_PUBLISHABLE_KEY=
OPENBSP_ORG_ID=
OPENBSP_PHONE_NUMBER_ID=
# Token compartido con OpenBSP para firmar los webhooks entrantes (Bearer).
# OBLIGATORIO: el endpoint /api/webhooks/openbsp responde 503 si falta.
OPENBSP_WEBHOOK_TOKEN=
# URL del proyecto Supabase que aloja OpenBSP (opcional, tiene default).
OPENBSP_SUPABASE_URL=

# --- Tally (formularios) ----------------------------------------------------
# Secreto compartido para validar firmas HMAC de Tally. OBLIGATORIO:
# /api/webhooks/tally responde 503 si falta (la validación no es opcional).
TALLY_SIGNING_SECRET=

# --- Resend (email) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Secreto Svix para validar webhooks de estado de email. OBLIGATORIO si se
# desea rastrear delivered/bounced/complained.
RESEND_WEBHOOK_SECRET=

# --- S3-compatible (media & documentos) --------------------------------------
# Opcional: si S3_BUCKET está presente se activa el storage de archivos
# (Cloudflare R2 o AWS S3). Sin S3, media se guarda localmente.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# --- Workspace --------------------------------------------------------------
# Tenant por defecto para admins sin tenant asignado explícitamente.
# Se resuelve por env, NUNCA hardcodeado en código.
WORKSPACE_DEFAULT_TENANT=martes

# --- Redes sociales (Metricool / Composio vía MCP) ---------------------------
# El sistema ya no llama la Graph API de Meta directamente: `social-posts`,
# `social-accounts`, `post-metrics` y `media` se administran y planifican aquí
# (Kanban, calendario, copy, imágenes) y la publicación real la hace un
# agente conectado por MCP a `/api/mcp` (este sistema) + al MCP de Metricool
# o Composio (que gestionan OAuth/tokens de Meta/TikTok/etc. de forma oficial).
# Sin variables de entorno propias que configurar de este lado.

# --- Copiloto IA del CRM (resumen de conversaciones) ------------------------
# Usa Vercel AI SDK v7 con el proveedor que esté configurado.
# Solo necesitas UNO de los dos. ANTHROPIC_API_KEY es preferido (Claude Haiku).
# Única llamada directa a un LLM que hace el sistema: el botón "Generar
# resumen IA" del drawer del lead (solo lectura del CRM del tenant activo).
# Cualquier análisis más abierto (chat general, redes sociales) se hace
# conectando un cliente MCP externo a /api/mcp — no un chat propio.
#
# Para activar el endpoint MCP (/api/mcp) desde clientes externos como Claude
# Desktop o Cursor, crea un API key en: /admin/collections/payload-mcp-api-keys
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   ← alternativa si no tienes Anthropic

# --- Campañas de email programadas -----------------------------------------
# Activa el envío automático de campañas con scheduledAt en el pasado.
# Requiere RESEND_API_KEY configurado. Por defecto false: las campañas con
# scheduledAt se acumulan y se envían manualmente desde el botón "Enviar".
EMAIL_CAMPAIGNS_AUTO_SEND=false

# --- Cron trigger (job queue) ------------------------------------------------
# El endpoint GET /api/cron dispara el job queue de Payload.
# Requiere este secreto en el header: Authorization: Bearer <CRON_SECRET>.
#
# Opciones para disparar el cron (Vercel Free no incluye crons nativos):
#
#  1. GitHub Actions — .github/workflows/trigger-jobs.yml (ya configurado).
#     Añadir en GitHub → Settings → Secrets → Actions:
#       APP_URL     = https://tu-app.vercel.app
#       CRON_SECRET = <mismo valor que aquí>
#     ⚠ GitHub deshabilita el workflow tras 60 días sin actividad en el repo.
#        Usar workflow_dispatch manual o Upstash QStash si el repo es poco activo.
#
#  2. Upstash QStash (https://upstash.com/qstash) — más confiable, free tier:
#     - 500 msg/día gratis. */5 * * * * = 288 ejecuciones/día.
#     - Crear Schedule → URL: https://tu-app.vercel.app/api/cron
#       Header: Authorization: Bearer <CRON_SECRET>
#       Cron: */5 * * * *
#
# En local dejar vacío — el handler corre sin validar el secreto.
CRON_SECRET=

# --- Webhook rate limiting (opcional, defaults sensatos) ---------------------
# WEBHOOK_RATE_LIMIT_MAX=120
# WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# --- Rate limiting de Server Actions autenticadas (IA/email/WhatsApp) -------
# Protege el resumen de IA, el envío de email y la respuesta rápida de
# WhatsApp del drawer del pipeline — la clave es el usuario, no la IP.
# Mismo backend que el rate limit de webhooks (Upstash Redis si está
# configurado arriba, si no memoria local por-instancia).
# ACTION_RATE_LIMIT_MAX=10
# ACTION_RATE_LIMIT_WINDOW_MS=60000

# --- Backend distribuido opcional para ambos rate limiters -------------------
# Si no se configuran, cada límite cae a memoria local (por-instancia, no
# compartido entre lambdas de Vercel). Con Upstash el límite es real.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# --- Sync de email de solo lectura (Gmail, Fase B) ---------------------------
# El CRM NO envía email por Gmail (eso sigue siendo Resend): este sync solo
# ESPEJA recibidos y enviados del buzón en `email-messages` (job sync-email,
# cada 15 min, idempotente por providerId) y los vincula a clients/leads por
# matching de direcciones.
#
# En Google Cloud Console (mismo proyecto OAuth que el calendario):
#  1. Habilitar la Gmail API.
#  2. Scope mínimo: https://www.googleapis.com/auth/gmail.readonly
#  3. Generar refresh_token offline para el usuario del buzón.
GMAIL_SYNC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Dirección del buzón a espejar (también excluye esa dirección del matching)
GMAIL_USER=
# Tenant al que pertenece el buzón (default: martes)
# GMAIL_TENANT_SLUG=martes
