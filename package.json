{
  "name": "martes-hub",
  "version": "0.1.0",
  "description": "CRM integral privado Martes Hub - Payload 3 + Neon + Vercel",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation node scripts/migrate.mjs migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation node scripts/migrate.mjs migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation node scripts/migrate.mjs migrate:status",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm migrate && pnpm build && pnpm lint"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/openai": "^4.0.50",
    "@copilotkit/react-core": "^1.69.3",
    "@copilotkit/react-ui": "^1.69.3",
    "@copilotkit/runtime": "^1.69.3",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-import-export": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/plugin-multi-tenant": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "^7.0.83",
    "cross-env": "10.1.0",
    "csv-parse": "^7.0.2",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.0",
    "payload": "3.88.0",
    "payload-invoicepdf": "^1.0.0",
    "payload-kanban-board": "3.0.24",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "svix": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.14",
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}